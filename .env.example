# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env. Generate secrets with:
#   openssl rand -base64 48   (JWT_SECRET)
#   openssl rand -base64 32   (BIOMETRIC_ENC_KEY — must decode to exactly 32 bytes)
#   openssl rand -hex 24      (FACE_API_KEY, DB_PASSWORD)
# ---------------------------------------------------------------------------
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-at-least-32-random-bytes
BIOMETRIC_ENC_KEY=
FACE_API_KEY=change-me-16-plus-characters

# Public URL users open (used for CORS)
PUBLIC_ORIGIN=https://attendance.local:8443
HTTP_PORT=8080
HTTPS_PORT=8443

# Face models: buffalo_l (accurate, default) or buffalo_s (faster on weak CPUs)
FACE_MODEL_PACK=buffalo_l
FACE_DET_SIZE=640
FACE_MAX_CONCURRENCY=2

# --- Capacity (see docs/SCALING.md) ---
# Number of backend copies behind nginx. 2 is the default; use 1 on a small laptop, 3-4 for ~5000 users.
BACKEND_REPLICAS=2
# Face-recognition workers (model copies, ~1 GB RAM each). 1 on a laptop, 2-4 on a server with 8+ cores.
FACE_WORKERS=1
# Per-IP login budget. Raise it when many users share one NAT address.
IP_LOGIN_ATTEMPTS_PER_MINUTE=600

# First administrator (created only when the database has no users; must change password at first login)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Demo data (3 platoons, 7 users, 36 fictional soldiers). NEVER enable in production.
DEMO_DATA_ENABLED=false
DEMO_PASSWORD=
